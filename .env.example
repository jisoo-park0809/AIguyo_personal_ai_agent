# 이 파일을 .env 로 복사해서 사용하세요.

# AI 공급자: openai | mock | pipeline
#  - 비워두면 OPENAI_API_KEY가 있을 때 openai, 없으면 mock(모의 응답)
#  - pipeline: 커리큘럼 생성을 생성 agent(generator_agent/)로 실행 (나머지 기능은 OpenAI)
AI_PROVIDER=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# 운영 규정집 PDF 폴더 / 나의 자료실 폴더 (기본: data/regulations, data/library)
# REGULATIONS_DIR=
# LIBRARY_DIR=

# PPT·Word에 지정할 폰트 이름, PDF에 임베드할 한글 TTF 경로
# DOC_FONT_NAME=맑은 고딕
# PDF_FONT_PATH=/System/Library/Fonts/Supplemental/AppleGothic.ttf

# LangSmith: 생성 agent(generator_agent) 실행 흐름을 https://smith.langchain.com 화면에서 보기
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=curriculum-generator
